# Production Environment Configuration
# Copy this file to .env and fill in the actual values
# NEVER commit the actual .env file with secrets!

# MongoDB Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_this_secure_password_min_16_chars
DB_NAME=inventory

# Backend Configuration
JWT_SECRET=change_this_to_random_64_char_string_generate_with_openssl_rand_hex_32

# CORS Settings - Your production domain(s)
CORS_ORIGINS=https://your-domain.ru,https://www.your-domain.ru

# Public URL for frontend build
PUBLIC_URL=https://your-domain.ru

# Optional: Email configuration for notifications (if implemented)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Optional: Backup configuration
# BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
# BACKUP_RETENTION_DAYS=30

# ============================================
# S3-Compatible Storage Configuration (Optional)
# ============================================
# If not configured, files will be stored locally in /app/uploads

# S3 Endpoint (Yandex Object Storage, AWS S3, etc.)
# Yandex Cloud: https://storage.yandexcloud.net
# AWS S3: https://s3.amazonaws.com or https://s3.region.amazonaws.com
S3_ENDPOINT=https://storage.yandexcloud.net

# S3 Region
# Yandex Cloud: ru-central1
# AWS: us-east-1, eu-west-1, etc.
S3_REGION=ru-central1

# S3 Bucket name (must be created via Terraform or manually)
S3_BUCKET=your-inventory-bucket

# S3 Access credentials (from Terraform output or manual creation)
S3_ACCESS_KEY_ID=your_access_key_id_here
S3_SECRET_ACCESS_KEY=your_secret_access_key_here

# Public base URL for files (CDN domain or bucket public URL)
# With CDN: https://cdn.your-domain.ru
# Without CDN: https://your-inventory-bucket.storage.yandexcloud.net
# Leave empty to auto-generate bucket URL
S3_PUBLIC_BASE_URL=https://cdn.your-domain.ru

# Presigned URL expiration time in seconds (default: 600 = 10 minutes)
PRESIGN_EXPIRES_SECONDS=600

# Maximum upload size in megabytes (default: 10)
UPLOAD_MAX_MB=10

# Security: Generate secure secrets with these commands:
# JWT_SECRET: openssl rand -hex 32
# MONGO_ROOT_PASSWORD: openssl rand -base64 32
