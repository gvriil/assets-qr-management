# ==============================================
# Inventory System - Environment Configuration
# ==============================================
# Copy this file to .env and fill in the values
# ==============================================

# MongoDB Configuration
# ---------------------
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123
DB_NAME=inventory

# JWT Configuration
# -----------------
# IMPORTANT: Generate a strong secret key!
# Example: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING

# Application URLs
# ----------------
# Your domain (with https://)
PUBLIC_URL=https://your-domain.ru

# CORS Origins (comma-separated if multiple)
CORS_ORIGINS=https://your-domain.ru

# Optional: Development mode
# --------------------------
# Set to 'true' only for local development
# DEBUG=false
